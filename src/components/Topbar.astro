---
import { site } from "../lib/site";
import Icon from "./Icon.astro";
// The link for the current page is white, the rest sit at 60%. "Join" is drawn as a white pill.
// Pages pass their own path ("/", "/404", "/articles", "/articles/<slug>", "/about", …), without the trailing slash.
// A nav link is current on its own path and on any path below it ("/articles" for "/articles/<slug>").
interface Props {
  path: string;
}
const { path } = Astro.props;
const isCurrent = (href: string) => href === path || (href !== "/" && !href.includes("#") && path.startsWith(`${href}/`));
---
<header class="topbar" data-topbar>
  <div class="topbar-bar container">
    <a href="/" class="topbar-logo" aria-label={`${site.name} home`}>
      <img src="/assets/logo-mark.webp" alt="" width="30" height="30" />
      <span class="body-sb">{site.name}</span>
    </a>
    <nav class="topbar-links" aria-label="Primary">
      {site.nav.map((l) => <a class:list={["body-sb", { "is-current": isCurrent(l.href), "topbar-cta": l.href === "/join" }]} href={l.href} aria-current={isCurrent(l.href) ? "page" : undefined}>{l.label}</a>)}
    </nav>
    <button type="button" class="topbar-menu" aria-label="Open menu" aria-expanded="false" data-menu-btn>
      <span class="topbar-icon" data-icon-open><Icon name="menu" size={24} stroke={1} /></span>
      <span class="topbar-icon" data-icon-close style="opacity: 0"><Icon name="x" size={24} stroke={1} /></span>
    </button>
  </div>
  <nav class="topbar-mobile" aria-label="Mobile" aria-hidden="true" data-mobile-nav>
    {site.nav.map((l) => <a class:list={["h3", { "is-current": isCurrent(l.href), "topbar-cta": l.href === "/join" }]} href={l.href} tabindex="-1">{l.label}</a>)}
  </nav>
</header>
