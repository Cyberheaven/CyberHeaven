---
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import Topbar from "../../components/Topbar.astro";
import Footer from "../../components/sections/Footer.astro";
import Icon from "../../components/Icon.astro";
import { site } from "../../lib/site";
import data from "../../data/phishing.json";

// Messages live in src/data/phishing.json. All companies and people in them are made up.
const { messages } = data;
---
<Base title={`Spot the phish | ${site.name}`} description="A free mini-game: decide whether each message is real or phishing, then learn the clues that give it away.">
  <Topbar path="/play/phishing" />
  <main>
    <PageHead title="Spot the phish" lead={`${messages.length} messages landed in your inbox. Some are real, some are phishing. Hover or tap each link to see where it really goes, then make the call.`} />

    <section class="ph container" data-ph aria-live="polite">
      <div class="ph-top" data-ph-top>
        <p class="caption muted"><span data-ph-count>Message 1 of {messages.length}</span> · Score <span data-ph-score>0</span></p>
        <div class="ph-progress" aria-hidden="true"><div class="ph-fill" data-ph-fill></div></div>
      </div>

      {messages.map((m, i) => (
        <article class="ph-round" data-round={i} data-phish={String(m.phish)} hidden={i > 0}>
          <div class="ph-mail">
            <p class="ph-kind caption">{m.kind}</p>
            <dl class="ph-meta">
              <div><dt>From</dt><dd><b>{m.fromName}</b> <span class="ph-addr">&lt;{m.fromAddress}&gt;</span></dd></div>
              <div><dt>Subject</dt><dd>{m.subject}</dd></div>
            </dl>
            <p class="ph-body">{m.body}</p>
            {m.linkText && (
              <span class="ph-link" tabindex="0">
                <span class="ph-link-text">{m.linkText}</span>
                <span class="ph-link-url" role="tooltip">Goes to: {m.linkUrl}</span>
              </span>
            )}
          </div>

          <div class="ph-choices" data-choices>
            <button type="button" class="btn btn-ghost" data-answer="false"><span class="body-sb">Looks legit</span></button>
            <button type="button" class="btn" data-answer="true"><span class="body-sb">It’s phishing</span></button>
          </div>

          <div class="ph-verdict" data-verdict hidden>
            <p class="h4" data-verdict-title></p>
            <p class="body muted">{m.phish ? "The clues:" : "Why it's safe:"}</p>
            <ul>{m.clues.map((c) => <li class="body">{c}</li>)}</ul>
            <button type="button" class="btn" data-next><span class="body-sb">{i < messages.length - 1 ? "Next message" : "See your score"}</span><Icon name="arrow-right" size={18} /></button>
          </div>
        </article>
      ))}

      <div class="ph-end" data-ph-end hidden>
        <p class="h2 balance" data-ph-final tabindex="-1"></p>
        <p class="body muted balance">Phishing works on everyone sometimes. The habit that beats it: slow down, check where links really go, and confirm unusual requests through a channel you already trust.</p>
        <div class="ph-actions">
          <button type="button" class="btn" data-ph-restart><span class="body-sb">Play again</span></button>
          <a class="btn btn-ghost" href="/glossary"><span class="body-sb">Browse the glossary</span><Icon name="arrow-up-right" size={20} /></a>
        </div>
      </div>
      <p class="caption muted ph-note">Every company, person, address and link in this game is made up for practice.</p>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .ph { padding: 0 20px 120px; display: flex; flex-direction: column; gap: 24px; }
  .ph > * { max-width: 880px; }
  .ph-top { display: flex; flex-direction: column; gap: 12px; }
  .ph-progress { height: 2px; background: var(--white-20); overflow: clip; }
  .ph-fill { height: 100%; background: var(--white); transform-origin: left; transform: scaleX(0); transition: transform 0.4s var(--ease-out); }

  .ph-round { display: flex; flex-direction: column; gap: 24px; animation: fadeIn 0.4s var(--ease-out); }
  .ph-round[hidden] { display: none; }
  .ph-mail { padding: 28px; border-radius: 16px; background: var(--grey-50); border: 1px solid var(--white-20); display: flex; flex-direction: column; gap: 18px; }
  .ph-kind { color: var(--white-60); }
  .ph-meta { margin: 0; display: flex; flex-direction: column; gap: 6px; padding-bottom: 18px; border-bottom: 1px solid var(--white-20); }
  .ph-meta div { display: grid; grid-template-columns: 72px 1fr; gap: 12px; font-size: 15px; }
  .ph-meta dt { color: var(--white-60); }
  .ph-meta dd { margin: 0; color: var(--grey); overflow-wrap: anywhere; }
  .ph-meta b { color: var(--white); font-weight: 600; }
  .ph-addr { color: var(--white-60); }
  .ph-body { white-space: pre-line; color: var(--grey); font-size: 16px; line-height: 1.6; }
  .ph-link { position: relative; align-self: flex-start; margin-bottom: 36px; cursor: pointer; outline: none; }
  .ph-link-text { display: inline-block; padding: 10px 18px; border-radius: 10px; background: var(--white); color: var(--black); font-weight: 600; }
  .ph-link-url { position: absolute; top: calc(100% + 8px); left: 0; width: max-content; max-width: min(560px, 80vw); font-size: 13px; padding: 6px 10px; border-radius: 8px; background: var(--black); border: 1px solid var(--white-20); color: var(--white); overflow-wrap: anywhere; opacity: 0; transform: translateY(-4px); transition: opacity 0.25s var(--ease-out), transform 0.25s var(--ease-out); }
  .ph-link:hover .ph-link-url, .ph-link:focus .ph-link-url, .ph-link.is-open .ph-link-url { opacity: 1; transform: none; }
  .ph-link:focus-visible .ph-link-text { outline: 2px solid var(--white); outline-offset: 3px; }

  .ph-choices, .ph-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .ph-verdict { display: flex; flex-direction: column; gap: 12px; padding: 24px; border-radius: 16px; border: 1px solid var(--white-20); animation: fadeIn 0.4s var(--ease-out); }
  .ph-verdict[hidden] { display: none; }
  .ph-verdict.is-right { border-color: var(--success); }
  .ph-verdict.is-wrong { border-color: var(--error); }
  .ph-verdict ul { margin: 0; padding-left: 1.1em; display: flex; flex-direction: column; gap: 6px; }
  .ph-verdict .btn { align-self: flex-start; margin-top: 8px; }
  .ph-end { display: flex; flex-direction: column; gap: 20px; animation: fadeIn 0.5s var(--ease-out); }
  .ph-end[hidden] { display: none; }
  .ph-end .h2 { line-height: 1.15em; outline: none; }
  .ph-end .body { max-width: 600px; }

  @media (max-width: 809px) {
    .ph-mail { padding: 20px; }
    .ph-choices .btn, .ph-actions .btn { flex: 1 1 100%; }
  }
  @media (prefers-reduced-motion: reduce) { .ph-round, .ph-verdict, .ph-end { animation: none; } .ph-fill, .ph-link-url { transition-duration: 0.01ms; } }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-ph]")!;
  const rounds = Array.from(root.querySelectorAll<HTMLElement>("[data-round]"));
  const top = root.querySelector<HTMLElement>("[data-ph-top]")!;
  const countEl = root.querySelector<HTMLElement>("[data-ph-count]")!;
  const scoreEl = root.querySelector<HTMLElement>("[data-ph-score]")!;
  const fill = root.querySelector<HTMLElement>("[data-ph-fill]")!;
  const end = root.querySelector<HTMLElement>("[data-ph-end]")!;
  const final = root.querySelector<HTMLElement>("[data-ph-final]")!;
  let score = 0;

  const show = (i: number) => {
    rounds.forEach((r, k) => (r.hidden = k !== i));
    end.hidden = true;
    top.hidden = false;
    countEl.textContent = `Message ${i + 1} of ${rounds.length}`;
    scoreEl.textContent = String(score);
    fill.style.transform = `scaleX(${i / rounds.length})`;
  };

  rounds.forEach((round, i) => {
    const choices = round.querySelector<HTMLElement>("[data-choices]")!;
    const verdict = round.querySelector<HTMLElement>("[data-verdict]")!;
    // Tapping a link on touch screens shows where it goes (instead of hover).
    round.querySelector(".ph-link")?.addEventListener("click", (e) => (e.currentTarget as HTMLElement).classList.toggle("is-open"));
    choices.querySelectorAll<HTMLButtonElement>("[data-answer]").forEach((b) =>
      b.addEventListener("click", () => {
        const phish = round.dataset.phish === "true";
        const right = (b.dataset.answer === "true") === phish;
        if (right) score++;
        scoreEl.textContent = String(score);
        choices.hidden = true;
        verdict.hidden = false;
        verdict.classList.toggle("is-right", right);
        verdict.classList.toggle("is-wrong", !right);
        verdict.querySelector("[data-verdict-title]")!.textContent = `${right ? "Correct" : "Not this time"}: ${phish ? "this is phishing." : "this one is legit."}`;
        verdict.querySelector<HTMLElement>("[data-next]")!.focus({ preventScroll: true });
      })
    );
    round.querySelector("[data-next]")!.addEventListener("click", () => {
      if (i < rounds.length - 1) return show(i + 1);
      rounds.forEach((r) => (r.hidden = true));
      top.hidden = true;
      end.hidden = false;
      final.textContent = `You spotted ${score} of ${rounds.length}. ${score === rounds.length ? "Flawless." : score >= rounds.length - 2 ? "Sharp eyes." : "Good practice. Try again?"}`;
      final.focus({ preventScroll: true });
    });
  });

  root.querySelector("[data-ph-restart]")!.addEventListener("click", () => {
    score = 0;
    rounds.forEach((r) => {
      r.querySelector<HTMLElement>("[data-choices]")!.hidden = false;
      r.querySelector<HTMLElement>("[data-verdict]")!.hidden = true;
    });
    show(0);
  });
</script>
