---
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import Topbar from "../../components/Topbar.astro";
import Footer from "../../components/sections/Footer.astro";
import Icon from "../../components/Icon.astro";
import DefenderNote from "../../components/DefenderNote.astro";
import { site, tool } from "../../lib/site";
import data from "../../data/loghunt.json";

// Cases live in src/data/loghunt.json (CMS: Interactive → Log hunt). Every IP address in them is from
// the ranges reserved for documentation (192.0.2.x, 198.51.100.x, 203.0.113.x), so none are real.
const { cases } = data;
// Heading, intro and search engine text: CMS Pages → Interactive (src/content/pages/interactive.json).
const lab = tool("/play/logs");
---
<Base title={`${lab.heading} | ${site.name}`} description={lab.seo}>
  <Topbar path="/play/logs" />
  <main>
    <PageHead title={lab.heading} lead={lab.lead}>
      <a class="text-link body-sb" href="/articles/introduction-to-digital-forensics-and-incident-response">Read the introduction to DFIR<Icon name="arrow-right" size={18} /></a>
    </PageHead>

    <section class="shell lab lh" data-lh data-cases={JSON.stringify(cases)}>
      <DefenderNote />
      {cases.length > 1 && (
        <div class="chips" role="group" aria-label="Cases">
          {cases.map((c, i) => <button type="button" class="chip" data-pick={i} aria-pressed={i === 0 ? "true" : "false"}><small>{i + 1}</small><span class="lh-tick" hidden><Icon name="check" size={14} stroke={2.5} /></span>{c.title}</button>)}
        </div>
      )}

      <div class="lh-grid">
        <div class="lh-left">
          <p class="body muted lh-intro" data-lh-intro></p>
          <div class="term lh-log">
            <div class="term-bar">
              <code data-lh-file></code>
              <span data-lh-shown aria-live="polite"></span>
            </div>
            <div class="lh-tools">
              <label class="search lh-search">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
                <span class="visually-hidden">Filter the log</span>
                <input type="search" data-lh-filter placeholder="Filter lines, like grep" autocomplete="off" spellcheck="false" />
              </label>
              <div class="chips lh-quick" data-lh-quick role="group" aria-label="Quick filters"></div>
            </div>
            <ol class="term-body lh-lines" data-lh-lines aria-label="Log lines. Press a line to pin it as evidence."></ol>
          </div>
        </div>

        <aside class="lh-side">
          <div class="panel">
            <div class="lh-progress" aria-hidden="true"><i data-lh-fill></i></div>
            <p class="caption muted" data-lh-count></p>
            <ol class="lh-qs" data-lh-qs></ol>
            <div class="verdict is-right" data-lh-done hidden>
              <b>Case closed.</b>
              <span class="body muted">You traced the attack from the first probe to the foothold. In a real incident this timeline goes straight into the report, and every pinned line is evidence.</span>
            </div>
          </div>
          <div class="panel lh-notes">
            <p class="body-sb">Pinned evidence <span class="muted" data-lh-pincount></span></p>
            <ol class="term-body lh-pins" data-lh-pins></ol>
            <p class="caption muted" data-lh-pinempty>Press any log line to pin it here.</p>
          </div>
        </aside>
      </div>

      <template data-lh-q>
        <li class="lh-q">
          <p class="body lh-qtext"></p>
          <form class="lh-answer">
            <input class="term-body" autocomplete="off" spellcheck="false" autocapitalize="off" />
            <button type="submit" class="btn btn-sm">Check</button>
          </form>
          <p class="caption lh-msg" aria-live="polite"></p>
          <button type="button" class="lh-hintbtn caption">Hint</button>
          <p class="body muted lh-explain" hidden></p>
        </li>
      </template>
    </section>
  </main>
  <Footer />
</Base>

<style is:global>
  /* global: the log lines, pins and questions are created by the script below */
  .lh-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 16px; align-items: start; }
  .lh-left { display: flex; flex-direction: column; gap: 16px; min-width: 0; }
  .lh-intro { max-width: 640px; }
  .lh-tools { display: flex; flex-direction: column; gap: 12px; padding: 16px; border-bottom: 1px solid var(--white-20); }
  .lh-search { max-width: none; height: 48px; }
  .lh-search input { font-family: var(--mono); font-size: 14px; }
  .lh-quick .chip { height: 34px; padding: 0 12px; font-family: var(--mono); font-size: 12.5px; font-weight: 400; }

  .lh-lines { list-style: none; margin: 0; padding: 8px 0; }
  .lh-line { display: grid; grid-template-columns: 4ch 14px minmax(0, 1fr); gap: 10px; padding: 3px 16px 3px 10px; cursor: pointer; transition: background 0.25s var(--ease-out); white-space: pre-wrap; overflow-wrap: anywhere; }
  .lh-line:focus-visible { outline: 1px solid var(--white); outline-offset: -1px; border-radius: 0; }
  .lh-n { color: var(--white-40); text-align: right; user-select: none; font-variant-numeric: tabular-nums; }
  .lh-pin { align-self: center; width: 6px; height: 6px; border-radius: 50%; background: transparent; transition: background 0.25s var(--ease-out), transform 0.35s var(--ease-out); }
  .lh-line[aria-pressed="true"] { background: rgba(255, 255, 255, 0.08); color: var(--white); }
  .lh-line[aria-pressed="true"] .lh-pin { background: var(--white); transform: scale(1.3); }
  @media (hover: hover) and (pointer: fine) { .lh-line:hover { background: rgba(255, 255, 255, 0.05); } }
  .lh-line.is-proof { animation: lh-proof 2.4s var(--ease-out); }
  @keyframes lh-proof { 0%, 30% { background: rgba(53, 199, 90, 0.28); color: var(--white); } }
  .lh-none { padding: 24px 16px; color: var(--white-60); font-family: var(--font); }

  .lh-side { position: sticky; top: 96px; display: flex; flex-direction: column; gap: 16px; }
  .lh-progress { height: 2px; background: var(--white-20); overflow: clip; }
  .lh-progress i { display: block; height: 100%; background: var(--white); transform-origin: left; transform: scaleX(0); transition: transform 0.5s var(--ease-out); }
  .lh-qs { list-style: none; margin: 0; padding: 0; counter-reset: q; display: flex; flex-direction: column; }
  .lh-q { counter-increment: q; display: flex; flex-direction: column; gap: 8px; padding: 16px 0; border-top: 1px solid var(--white-20); }
  .lh-q:first-child { border-top: 0; padding-top: 4px; }
  .lh-qtext { color: var(--white); }
  .lh-qtext::before { content: counter(q) ". "; color: var(--white-40); }
  .lh-answer { display: flex; gap: 8px; }
  .lh-answer input { flex: 1; min-width: 0; height: 44px; padding: 0 14px; border-radius: 22px; border: 1px solid var(--white-20); background: var(--black); color: var(--white); font-size: 14px; transition: border-color 0.3s var(--ease-out); }
  .lh-answer input:focus { outline: none; border-color: var(--white); }
  .lh-q.is-right .lh-answer input { border-color: var(--success); }
  .lh-q.is-right .lh-answer button { display: none; }
  .lh-msg:empty { display: none; }
  .lh-msg.is-wrong { color: rgb(255, 130, 136); }
  .lh-msg.is-right { color: rgb(120, 220, 145); }
  .lh-hintbtn { align-self: flex-start; padding: 2px 0; border: 0; background: none; color: var(--white-60); text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
  @media (hover: hover) and (pointer: fine) { .lh-hintbtn:hover { color: var(--white); } }
  .lh-hintbtn.is-open { text-decoration: none; cursor: default; color: var(--grey); font-size: 14px; text-align: left; }

  .lh-notes { gap: 10px; }
  .lh-pins { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
  .lh-pins:empty { display: none; }
  .lh-pins button { width: 100%; padding: 8px 10px; border: 1px solid var(--white-20); border-radius: 8px; background: var(--black); color: var(--grey); font: inherit; font-size: 12px; text-align: left; overflow-wrap: anywhere; cursor: pointer; }
  .lh-pins b { color: var(--white-40); font-weight: 400; margin-right: 8px; }
  .lh-tick { display: inline-flex; color: var(--success); }
  .chip[aria-pressed="true"] .lh-tick { color: rgb(30, 140, 60); }

  @media (max-width: 1199px) { .lh-grid { grid-template-columns: minmax(0, 1fr); } .lh-side { position: static; order: -1; } }
  @media (max-width: 809px) { .lh-lines { font-size: 12px; } .lh-line { grid-template-columns: 3ch 8px minmax(0, 1fr); gap: 6px; padding-right: 10px; } }
  @media (prefers-reduced-motion: reduce) { .lh-line.is-proof { animation: none; background: rgba(53, 199, 90, 0.2); } .lh-progress i { transition: none; } }
</style>

<script>
  import { scrollToY } from "../../scripts/lib";

  type Question = { question: string; answers: string[]; hint: string; explain: string; evidence?: string };
  type Case = { title: string; file: string; intro: string; filters: string[]; lines: string[]; questions: Question[] };
  const root = document.querySelector<HTMLElement>("[data-lh]")!;
  const cases: Case[] = JSON.parse(root.dataset.cases!);
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector<T>(s)!;
  const linesEl = $("[data-lh-lines]");
  const filter = $<HTMLInputElement>("[data-lh-filter]");
  const quick = $("[data-lh-quick]");
  const qsEl = $("[data-lh-qs]");
  const tpl = $<HTMLTemplateElement>("[data-lh-q]");
  const norm = (s: string) => s.trim().toLowerCase().replace(/\s+/g, " ");
  let current = 0;
  let pinned = new Set<number>();
  let solved = new Set<number>();

  // One <li> per log line; filtering only hides lines and redraws the highlight.
  const drawLines = () => {
    const c = cases[current];
    linesEl.replaceChildren(
      ...c.lines.map((text, n) => {
        const li = document.createElement("li");
        li.className = "lh-line";
        li.tabIndex = 0;
        li.setAttribute("role", "button");
        li.setAttribute("aria-pressed", "false");
        li.dataset.n = String(n);
        li.innerHTML = `<span class="lh-n">${n + 1}</span><span class="lh-pin"></span><span class="lh-t"></span>`;
        li.querySelector(".lh-t")!.textContent = text;
        return li;
      })
    );
    const none = document.createElement("li");
    none.className = "lh-none";
    none.textContent = "No lines match. Try a shorter filter.";
    none.hidden = true;
    linesEl.append(none);
  };

  const applyFilter = () => {
    const c = cases[current];
    const q = filter.value.trim().toLowerCase();
    let shown = 0;
    linesEl.querySelectorAll<HTMLElement>(".lh-line").forEach((li) => {
      const text = c.lines[Number(li.dataset.n)];
      const at = q ? text.toLowerCase().indexOf(q) : -1;
      li.hidden = !!q && at < 0;
      if (!li.hidden) shown++;
      const t = li.querySelector(".lh-t")!;
      t.replaceChildren();
      if (at < 0) t.textContent = text;
      else {
        // mark every match, not just the first
        let i = 0;
        for (let k = at; k >= 0; k = text.toLowerCase().indexOf(q, i)) {
          const m = document.createElement("mark");
          m.textContent = text.slice(k, k + q.length);
          t.append(text.slice(i, k), m);
          i = k + q.length;
        }
        t.append(text.slice(i));
      }
    });
    (linesEl.lastElementChild as HTMLElement).hidden = shown > 0;
    $("[data-lh-shown]").textContent = q ? `${shown} of ${c.lines.length} lines` : `${c.lines.length} lines`;
    quick.querySelectorAll<HTMLButtonElement>("button").forEach((b) => b.setAttribute("aria-pressed", String(b.textContent === filter.value)));
  };

  const drawPins = () => {
    const c = cases[current];
    const pins = $("[data-lh-pins]");
    pins.replaceChildren(
      ...[...pinned].sort((a, b) => a - b).map((n) => {
        const li = document.createElement("li");
        const b = document.createElement("button");
        b.type = "button";
        b.title = "Unpin";
        b.innerHTML = `<b>${n + 1}</b>`;
        b.append(c.lines[n]);
        b.addEventListener("click", () => togglePin(n));
        li.append(b);
        return li;
      })
    );
    $("[data-lh-pincount]").textContent = pinned.size ? `(${pinned.size})` : "";
    $("[data-lh-pinempty]").hidden = pinned.size > 0;
  };

  const togglePin = (n: number) => {
    pinned.has(n) ? pinned.delete(n) : pinned.add(n);
    linesEl.querySelector(`[data-n="${n}"]`)?.setAttribute("aria-pressed", String(pinned.has(n)));
    drawPins();
  };

  // Light up the lines that prove an answer, and bring the first into view inside the log.
  const prove = (evidence?: string) => {
    if (!evidence) return;
    const e = evidence.toLowerCase();
    const hits = Array.from(linesEl.querySelectorAll<HTMLElement>(".lh-line")).filter((li) => cases[current].lines[Number(li.dataset.n)].toLowerCase().includes(e));
    if (hits.some((li) => li.hidden)) {
      filter.value = "";
      applyFilter();
    }
    hits.forEach((li) => {
      li.classList.remove("is-proof");
      void li.offsetWidth;
      li.classList.add("is-proof");
    });
    if (hits[0] && innerWidth >= 1200) scrollToY(hits[0].getBoundingClientRect().top + window.scrollY - innerHeight / 3);
  };

  const progress = () => {
    const c = cases[current];
    $("[data-lh-count]").textContent = `${solved.size} of ${c.questions.length} answered`;
    $("[data-lh-fill]").style.transform = `scaleX(${solved.size / c.questions.length})`;
    const done = solved.size === c.questions.length;
    $("[data-lh-done]").hidden = !done;
    if (done) {
      const chip = root.querySelector(`[data-pick="${current}"]`);
      chip?.querySelector("small")?.setAttribute("hidden", "");
      chip?.querySelector(".lh-tick")?.removeAttribute("hidden");
    }
  };

  const drawQuestions = () => {
    const c = cases[current];
    qsEl.replaceChildren(
      ...c.questions.map((q, k) => {
        const li = (tpl.content.firstElementChild as HTMLElement).cloneNode(true) as HTMLElement;
        const input = li.querySelector("input")!;
        const msg = li.querySelector<HTMLElement>(".lh-msg")!;
        const hint = li.querySelector<HTMLButtonElement>(".lh-hintbtn")!;
        li.querySelector(".lh-qtext")!.textContent = q.question;
        input.setAttribute("aria-label", `Answer to question ${k + 1}`);
        li.querySelector(".lh-explain")!.textContent = q.explain;
        hint.addEventListener("click", () => {
          if (hint.classList.contains("is-open")) return;
          hint.classList.add("is-open");
          hint.textContent = q.hint;
        });
        li.querySelector("form")!.addEventListener("submit", (e) => {
          e.preventDefault();
          if (solved.has(k)) return;
          const right = q.answers.some((a) => norm(a) === norm(input.value));
          msg.className = `caption lh-msg ${right ? "is-right" : "is-wrong"}`;
          msg.textContent = right ? "Correct." : input.value.trim() ? "Not quite. Check the log again." : "Type an answer first.";
          if (!right) return;
          solved.add(k);
          li.classList.add("is-right");
          input.readOnly = true;
          li.querySelector<HTMLElement>(".lh-explain")!.hidden = false;
          prove(q.evidence);
          progress();
          (qsEl.children[k + 1]?.querySelector("input") as HTMLInputElement | null)?.focus({ preventScroll: true });
        });
        return li;
      })
    );
  };

  const pick = (i: number) => {
    current = i;
    const c = cases[i];
    pinned = new Set();
    solved = new Set();
    root.querySelectorAll<HTMLButtonElement>("[data-pick]").forEach((b) => b.setAttribute("aria-pressed", String(Number(b.dataset.pick) === i)));
    $("[data-lh-intro]").textContent = c.intro;
    $("[data-lh-file]").textContent = c.file;
    quick.replaceChildren(
      ...c.filters.map((f) => {
        const b = document.createElement("button");
        b.type = "button";
        b.className = "chip";
        b.textContent = f;
        b.addEventListener("click", () => {
          filter.value = filter.value === f ? "" : f;
          applyFilter();
        });
        return b;
      })
    );
    filter.value = "";
    drawLines();
    applyFilter();
    drawPins();
    drawQuestions();
    progress();
  };

  linesEl.addEventListener("click", (e) => {
    const li = (e.target as HTMLElement).closest<HTMLElement>(".lh-line");
    if (li && !getSelection()?.toString()) togglePin(Number(li.dataset.n));
  });
  linesEl.addEventListener("keydown", (e) => {
    const li = (e.target as HTMLElement).closest<HTMLElement>(".lh-line");
    if (li && (e.key === "Enter" || e.key === " ")) {
      e.preventDefault();
      togglePin(Number(li.dataset.n));
    }
  });
  filter.addEventListener("input", applyFilter);
  root.querySelectorAll<HTMLButtonElement>("[data-pick]").forEach((b) => b.addEventListener("click", () => pick(Number(b.dataset.pick))));
  pick(0);
</script>
