---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import Topbar from "../components/Topbar.astro";
import Footer from "../components/sections/Footer.astro";
import Icon from "../components/Icon.astro";
import ToolCards from "../components/ToolCards.astro";
import { getArticles, site } from "../lib/site";
import career from "../data/career.json";

// Questions, paths and starting levels live in src/data/career.json; the adaptive logic (which question
// comes next, scoring, reasons) is in src/lib/career.mjs. Check both with `node scripts/check-career.mjs`.
const { paths } = career;
const articles = await getArticles();
const titleOf = (slug: string) => articles.find((a) => a.id === slug)?.data.title;
const labsOf = (hrefs: string[]) => hrefs.map((h) => site.tools.find((t) => t.href === h)).filter((t) => t !== undefined);
---
<Base title={`Find your path in cybersecurity | ${site.name}`} description="A free, personal career quiz for cybersecurity beginners. Each question adapts to your last answer, and you get a path, the reasons it fits you and your first three steps.">
  <Topbar path="/career" />
  <main>
    <PageHead title="Find your path in cybersecurity" lead="No experience needed. Answer a few quick questions, each one shaped by what you said before, and get the path that fits you, why it fits, and your first three steps." />

    <section class="shell cr" data-cr data-quiz={JSON.stringify(career)}>
      <div class="cr-play" data-cr-play>
        <div class="cr-stage">
          <div class="cr-top">
            <button type="button" class="cr-back" data-cr-back hidden><Icon name="arrow-right" size={16} />Back</button>
            <p class="caption muted" data-cr-count></p>
            <div class="cr-progress" aria-hidden="true"><i data-cr-fill></i></div>
          </div>
          <div class="cr-question" data-cr-question aria-live="polite"></div>
        </div>

        <aside class="cr-meter" aria-label="Your matches so far">
          <p class="body-sb">Your path is taking shape</p>
          <p class="caption muted" data-cr-hint>Every answer moves these. The quiz asks about whichever paths are closest.</p>
          <ol class="cr-rows" data-cr-rows>
            {paths.map((p) => (
              <li class="cr-row" data-row={p.id}>
                <span class="cr-row-name">{p.name}</span>
                <span class="cr-bar"><i data-bar></i></span>
              </li>
            ))}
          </ol>
        </aside>
      </div>

      {paths.map((p) => (
        <article class="cr-result" data-result={p.id} hidden>
          <header class="cr-r-head">
            <p class="cr-r-match"><span>Your best match</span> · {p.tagline}</p>
            <h2 class="cr-r-name" tabindex="-1">{p.name.split(" ").map((w, i) => <><span class="cr-w" style={`--d: ${i * 70}ms`}>{w}</span>{" "}</>)}</h2>
            <p class="cr-r-summary balance">{p.summary}</p>
          </header>

          <div class="cr-r-cols">
            <div class="cr-r-col">
              <h3 class="h4">Why it fits you</h3>
              <ul class="cr-quotes" data-r-reasons></ul>
            </div>
            <div class="cr-r-col">
              <h3 class="h4">A day in the job</h3>
              <ul class="cr-list">{p.day.map((d) => <li>{d}</li>)}</ul>
            </div>
            <div class="cr-r-col">
              <h3 class="h4">Your first three steps</h3>
              <ol class="cr-steps">
                <li data-r-level></li>
                {p.start.map((d) => <li>{d}</li>)}
              </ol>
            </div>
          </div>

          <div class="cr-r-block">
            <h3 class="h3">Try it right now</h3>
            <ToolCards tools={labsOf(p.labs)} dense />
          </div>

          <div class="cr-r-block cr-r-learn">
            <h3 class="h3">Keep learning, free</h3>
            <ul class="bigrows">
              {p.guides.filter(titleOf).map((g) => (
                <li><a class="bigrow cr-learn" href={`/articles/${g}`}><span class="cr-learn-name">{titleOf(g)}</span><span class="caption muted">Guide on {site.name}</span><span class="round-btn bigrow-btn" aria-hidden="true"><Icon name="arrow-up-right" size={20} /></span></a></li>
              ))}
              {p.links.map((l) => (
                <li><a class="bigrow cr-learn" href={l.href} target="_blank" rel="noopener"><span class="cr-learn-name">{l.label}</span><span class="caption muted">Free resource · opens in a new tab</span><span class="round-btn bigrow-btn" aria-hidden="true"><Icon name="arrow-up-right" size={20} /></span></a></li>
              ))}
            </ul>
          </div>
        </article>
      ))}

      <div class="cr-after" data-cr-after hidden>
        <div class="cr-also">
          <p class="body-sb">Also close for you</p>
          <div class="cr-also-list" data-cr-also></div>
        </div>
        <div class="cr-actions">
          <button type="button" class="btn" data-cr-restart><span class="body-sb">Take it again</span></button>
          <a class="btn btn-ghost" href="/interactive"><span class="body-sb">Browse every lab</span><Icon name="arrow-up-right" size={20} /></a>
        </div>
        <p class="caption muted">This is a starting point, not a verdict. Most people try a few areas before they settle, and every path shares the same foundations.</p>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style is:global>
  /* global: the questions, options and reasons are drawn by the script below */
  .cr { padding-bottom: 120px; display: flex; flex-direction: column; gap: 64px; }
  .cr-play { display: grid; grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); gap: 56px; align-items: start; }
  .cr-stage { display: flex; flex-direction: column; gap: 40px; min-width: 0; min-height: 560px; }
  .cr-top { display: grid; grid-template-columns: auto 1fr; align-items: center; gap: 12px 20px; }
  .cr-top .caption { grid-column: 2; justify-self: end; font-variant-numeric: tabular-nums; }
  .cr-back { grid-column: 1; display: inline-flex; align-items: center; gap: 6px; padding: 4px 0; border: 0; background: none; color: var(--white-60); font-size: 14px; font-weight: 600; cursor: pointer; transition: color 0.3s var(--ease-out); }
  .cr-back svg { transform: rotate(180deg); }
  @media (hover: hover) and (pointer: fine) { .cr-back:hover { color: var(--white); } }
  .cr-progress { grid-column: 1 / -1; height: 2px; background: var(--white-20); overflow: clip; }
  .cr-progress i { display: block; height: 100%; background: var(--white); transform-origin: left; transform: scaleX(0); transition: transform 0.8s var(--ease-out); }

  .cr-question { display: flex; flex-direction: column; gap: 32px; }
  .cr-q { font-size: clamp(34px, 4.4vw, 60px); font-weight: 600; letter-spacing: -0.04em; line-height: 1.08; color: var(--white); text-wrap: balance; outline: none; }
  .cr-w { display: inline-block; animation: wordIn 0.9s var(--ease-out) both; animation-delay: var(--d); }
  .cr-sub { max-width: 560px; font-size: 18px; line-height: 1.5; color: var(--white-60); animation: wordIn 0.9s var(--ease-out) both; animation-delay: var(--d); }
  .cr-sub q { color: var(--white); quotes: "“" "”"; }

  .cr-opts { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--white-20); }
  .cr-opts li { border-bottom: 1px solid var(--white-20); animation: cr-rise 0.7s var(--ease-out) both; animation-delay: var(--d); }
  @keyframes cr-rise { from { opacity: 0; transform: translate3d(0, 14px, 0); } }
  .cr-opt {
    position: relative; isolation: isolate; width: 100%; display: grid; grid-template-columns: 32px minmax(0, 1fr) auto; align-items: center; gap: 20px;
    padding: 24px 0; border: 0; background: none; color: var(--white); text-align: left; cursor: pointer; font: inherit;
    transition: color 0.45s var(--ease-out), opacity 0.4s var(--ease-out);
  }
  /* on hover the number and text slide right (transform, so no layout work) */
  .cr-key, .cr-opt-text { transition: transform 0.55s var(--ease-out), border-color 0.45s var(--ease-out), color 0.45s var(--ease-out); }
  .cr-opt::before { content: ""; position: absolute; inset: 0 -20px; z-index: -1; background: var(--white); clip-path: inset(0 100% 0 0); transition: clip-path 0.55s var(--ease-out); }
  .cr-key { width: 32px; height: 32px; border-radius: 50%; border: 1px solid var(--white-20); display: grid; place-items: center; font-family: var(--mono); font-size: 13px; color: var(--white-60); }
  .cr-opt-text { font-size: 22px; font-weight: 500; letter-spacing: -0.03em; line-height: 1.3; }
  .cr-opt .round-btn { width: 48px; height: 48px; transition: background 0.45s var(--ease-out), color 0.45s var(--ease-out), border-color 0.45s var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .cr-opt:hover { color: var(--black); }
    .cr-opt:hover .cr-key, .cr-opt:hover .cr-opt-text { transform: translateX(16px); }
    .cr-opt:hover::before { clip-path: inset(0 0 0 0); }
    .cr-opt:hover .cr-key { border-color: rgba(18, 18, 18, 0.3); color: rgba(18, 18, 18, 0.7); }
    .cr-opt:hover .round-btn { background: var(--black); color: var(--white); border-color: var(--black); }
  }
  .cr-opt.is-picked { color: var(--black); }
  .cr-opt.is-picked .cr-key, .cr-opt.is-picked .cr-opt-text { transform: translateX(16px); }
  .cr-opt.is-picked::before { clip-path: inset(0 0 0 0); }
  .cr-opt.is-picked .round-btn { background: var(--black); color: var(--white); border-color: var(--black); }
  .cr-opt.is-picked .cr-key { border-color: rgba(18, 18, 18, 0.3); color: rgba(18, 18, 18, 0.7); }
  .cr-opts.is-locked .cr-opt:not(.is-picked) { opacity: 0.25; }
  .cr-opt:focus-visible { outline: 2px solid var(--white); outline-offset: 4px; border-radius: 4px; }

  .cr-meter { position: sticky; top: 100px; display: flex; flex-direction: column; gap: 10px; padding: 28px; border-radius: 16px; background: var(--grey-50); border: 1px solid var(--white-20); }
  .cr-rows { list-style: none; margin: 10px 0 0; padding: 0; display: flex; flex-direction: column; gap: 14px; }
  .cr-row { display: grid; grid-template-columns: minmax(0, 1fr); gap: 6px 12px; font-size: 14px; color: var(--white-60); transition: color 0.5s var(--ease-out); }
  .cr-bar { grid-column: 1 / -1; height: 4px; border-radius: 4px; background: var(--white-20); overflow: clip; }
  .cr-bar i { display: block; height: 100%; border-radius: 4px; background: var(--white-40); transform-origin: left; transform: scaleX(0); transition: transform 0.9s var(--ease-out), background 0.5s var(--ease-out); }
  .cr-row.is-lead { color: var(--white); font-weight: 600; }
  .cr-row.is-lead .cr-bar i { background: var(--white); }

  .cr-result { display: flex; flex-direction: column; gap: 72px; }
  .cr-r-head { display: flex; flex-direction: column; gap: 20px; max-width: 980px; }
  .cr-r-match { font-size: 16px; font-weight: 600; color: var(--white-60); animation: fadeIn 0.8s var(--ease-out) both; }
  .cr-r-match span { color: rgb(120, 220, 145); }
  .cr-r-name { font-size: clamp(44px, 7vw, 96px); font-weight: 600; letter-spacing: -0.045em; line-height: 1; color: var(--white); outline: none; }
  .cr-r-summary { max-width: 640px; font-size: 20px; line-height: 1.5; color: var(--grey); animation: wordIn 1s var(--ease-out) both; animation-delay: 0.35s; }
  .cr-r-cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .cr-r-col { display: flex; flex-direction: column; gap: 16px; padding: 28px; border-radius: 16px; background: var(--grey-50); border: 1px solid var(--white-20); animation: cr-rise 0.8s var(--ease-out) both; }
  .cr-r-col:nth-child(2) { animation-delay: 0.1s; }
  .cr-r-col:nth-child(3) { animation-delay: 0.2s; }
  .cr-quotes, .cr-list, .cr-steps { margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; font-size: 16px; line-height: 1.5; color: var(--grey); }
  .cr-quotes { list-style: none; }
  .cr-quotes li { padding-left: 14px; border-left: 1px solid var(--white-40); color: var(--white); }
  .cr-quotes li::before { content: "You said: "; color: var(--white-60); }
  .cr-list { padding-left: 1.1em; }
  .cr-steps { padding-left: 1.3em; }
  .cr-steps li::marker { color: var(--white-60); font-weight: 600; }
  .cr-steps li:first-child { color: var(--white); }
  .cr-r-block { display: flex; flex-direction: column; gap: 28px; }
  .cr-learn { grid-template-columns: minmax(0, 6fr) minmax(0, 4fr) auto; padding: 28px 0; }
  .cr-learn-name { font-size: 32px; font-weight: 600; letter-spacing: -0.04em; line-height: 1.15; overflow-wrap: anywhere; }

  .cr-after { display: flex; flex-direction: column; gap: 32px; padding-top: 48px; border-top: 1px solid var(--white-20); }
  .cr-also { display: flex; flex-direction: column; gap: 14px; }
  .cr-also-list { display: flex; flex-wrap: wrap; gap: 12px; }
  .cr-also-btn { display: inline-flex; align-items: baseline; gap: 12px; padding: 16px 22px; border-radius: 16px; border: 1px solid var(--white-20); background: var(--grey-50); color: var(--white); font: inherit; font-size: 18px; font-weight: 600; letter-spacing: -0.02em; cursor: pointer; transition: border-color 0.3s var(--ease-out), background 0.3s var(--ease-out); }
  .cr-also-btn small { font-size: 14px; font-weight: 400; color: var(--white-60); font-variant-numeric: tabular-nums; }
  @media (hover: hover) and (pointer: fine) { .cr-also-btn:hover { border-color: var(--white-60); background: rgba(255, 255, 255, 0.06); } }
  .cr-actions { display: flex; flex-wrap: wrap; gap: 12px; }

  @media (max-width: 1199px) {
    .cr-play { grid-template-columns: minmax(0, 1fr); gap: 40px; }
    .cr-stage { min-height: 0; }
    .cr-meter { position: static; }
    .cr-r-cols { grid-template-columns: minmax(0, 1fr); }
    .cr-learn-name { font-size: 26px; }
  }
  @media (max-width: 809px) {
    .cr { gap: 48px; }
    .cr-opt { grid-template-columns: 28px minmax(0, 1fr) auto; gap: 14px; padding: 20px 0; }
    .cr-opt-text { font-size: 18px; }
    .cr-opt .round-btn { width: 40px; height: 40px; }
    .cr-key { width: 28px; height: 28px; }
    .cr-meter { padding: 20px; }
    .cr-row:nth-child(n + 4) { display: none; }
    .cr-r-col { padding: 20px; }
    .cr-learn { grid-template-columns: minmax(0, 1fr) auto; }
    .cr-learn .caption { grid-row: 2; }
    .cr-learn-name { font-size: 22px; }
    .cr-r-summary { font-size: 17px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cr-w, .cr-sub, .cr-opts li, .cr-r-match, .cr-r-summary, .cr-r-col { animation: none; }
    .cr-opt, .cr-opt::before, .cr-key, .cr-opt-text, .cr-progress i, .cr-bar i, .cr-row { transition-duration: 0.01ms; }
  }
</style>

<script>
  import { ranking, nextQuestion, reasons, levelOf, followsFrom } from "../lib/career.mjs";
  import { reducedMotion, scrollToY } from "../scripts/lib";

  type Option = { a: string; score: Record<string, number>; next?: string; level?: string };
  type Question = { id: string; stage: string; q: string; sub?: string; options: Option[] };
  type Data = { paths: { id: string; name: string }[]; levels: { id: string; step: string }[]; questions: Question[] };
  type Answer = { id: string; option: number };

  const root = document.querySelector<HTMLElement>("[data-cr]")!;
  const data: Data = JSON.parse(root.dataset.quiz!);
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector<T>(s)!;
  const stage = $("[data-cr-question]");
  const rowsEl = $("[data-cr-rows]");
  const nameOf = Object.fromEntries(data.paths.map((p) => [p.id, p.name]));
  // Rough total for the progress bar: the quiz asks between 6 and 8 questions.
  const EXPECTED = 8;
  let answers: Answer[] = [];
  let busy = false;

  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls = "", text = "") => {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text) e.textContent = text;
    return e;
  };

  // The live meter: bars grow, and rows slide into their new order (FLIP).
  const drawMeter = () => {
    const rank = ranking(data, answers);
    // bars are relative to whoever leads right now, so early answers don't read as "100% match"
    const lead = Math.max(1, rank[0].score);
    const rows = Array.from(rowsEl.children) as HTMLElement[];
    const before = new Map(rows.map((r) => [r, r.getBoundingClientRect().top]));
    rank.forEach((r, i) => {
      const row = rowsEl.querySelector<HTMLElement>(`[data-row="${r.id}"]`)!;
      row.querySelector<HTMLElement>("[data-bar]")!.style.transform = `scaleX(${r.score / lead})`;
      row.classList.toggle("is-lead", i === 0 && r.score > 0);
      rowsEl.append(row);
    });
    if (reducedMotion()) return;
    for (const row of rows) {
      const dy = before.get(row)! - row.getBoundingClientRect().top;
      if (!dy) continue;
      row.animate([{ transform: `translateY(${dy}px)` }, { transform: "none" }], { duration: 700, easing: "cubic-bezier(0.22, 1, 0.36, 1)" });
    }
  };

  const ask = (q: Question) => {
    busy = false;
    const n = answers.length;
    $("[data-cr-count]").textContent = `Question ${n + 1}`;
    $("[data-cr-fill]").style.transform = `scaleX(${Math.min(n / EXPECTED, 0.95)})`;
    $("[data-cr-back]").hidden = n === 0;

    const title = el("h2", "cr-q");
    title.tabIndex = -1;
    q.q.split(" ").forEach((w, i) => {
      const s = el("span", "cr-w", w);
      s.style.setProperty("--d", `${i * 45}ms`);
      title.append(s, " ");
    });
    const after = q.q.split(" ").length * 45 + 100;
    const parts: HTMLElement[] = [title];

    // A follow-up quotes the answer it follows from; otherwise show the question's own note.
    const from = followsFrom(data, answers, q);
    if (from || q.sub) {
      const sub = el("p", "cr-sub");
      sub.style.setProperty("--d", `${after}ms`);
      if (from) {
        sub.append("Because you picked ", el("q", "", from), ".");
      } else sub.textContent = q.sub!;
      parts.push(sub);
    }

    const list = el("ol", "cr-opts");
    q.options.forEach((o, i) => {
      const li = el("li");
      li.style.setProperty("--d", `${after + 120 + i * 70}ms`);
      const b = el("button", "cr-opt");
      b.type = "button";
      b.append(el("span", "cr-key", String(i + 1)), el("span", "cr-opt-text", o.a));
      const arrow = el("span", "round-btn");
      arrow.setAttribute("aria-hidden", "true");
      arrow.innerHTML = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>`;
      b.append(arrow);
      b.addEventListener("click", () => choose(q, i, b, list));
      li.append(b);
      list.append(li);
    });
    parts.push(list);
    stage.replaceChildren(...parts);
    title.focus({ preventScroll: true });
  };

  const choose = (q: Question, i: number, b: HTMLElement, list: HTMLElement) => {
    if (busy) return;
    busy = true;
    answers.push({ id: q.id, option: i });
    b.classList.add("is-picked");
    list.classList.add("is-locked");
    drawMeter();
    setTimeout(advance, reducedMotion() ? 0 : 520);
  };

  const advance = () => {
    const q = nextQuestion(data, answers);
    if (q) {
      ask(q);
      const top = root.getBoundingClientRect().top;
      if (top < 0) scrollToY(window.scrollY + top - 100);
    } else finish();
  };

  const showResult = (id: string) => {
    root.querySelectorAll<HTMLElement>("[data-result]").forEach((r) => (r.hidden = r.dataset.result !== id));
    const r = $(`[data-result="${id}"]`);
    const why = reasons(data, answers, id);
    r.querySelector("[data-r-reasons]")!.replaceChildren(...(why.length ? why : ["A mix of your answers points here, even without one standout reason."]).map((t) => el("li", "", t)));
    const level = data.levels.find((l) => l.id === levelOf(data, answers));
    r.querySelector("[data-r-level]")!.textContent = level?.step ?? data.levels[0].step;

    // the next two closest paths, to compare
    const rank = ranking(data, answers).filter((x) => x.id !== id).slice(0, 2);
    $("[data-cr-also]").replaceChildren(
      ...rank.map((x) => {
        const btn = el("button", "cr-also-btn", nameOf[x.id]);
        btn.type = "button";
        btn.append(el("small", "", "See this path"));
        btn.addEventListener("click", () => {
          showResult(x.id);
          scrollToY(r.parentElement!.getBoundingClientRect().top + window.scrollY - 100);
        });
        return btn;
      })
    );
    r.querySelectorAll<HTMLElement>(".cr-w, .cr-r-col, .cr-r-match, .cr-r-summary").forEach((e) => {
      e.style.animation = "none";
      void e.offsetWidth;
      e.style.animation = "";
    });
    r.querySelector<HTMLElement>(".cr-r-name")!.focus({ preventScroll: true });
  };

  const finish = () => {
    $("[data-cr-play]").hidden = true;
    $("[data-cr-after]").hidden = false;
    showResult(ranking(data, answers)[0].id);
    scrollToY(root.getBoundingClientRect().top + window.scrollY - 100);
  };

  const start = () => {
    answers = [];
    $("[data-cr-play]").hidden = false;
    $("[data-cr-after]").hidden = true;
    root.querySelectorAll<HTMLElement>("[data-result]").forEach((r) => (r.hidden = true));
    drawMeter();
    ask(nextQuestion(data, answers)!);
  };

  $("[data-cr-back]").addEventListener("click", () => {
    if (busy || !answers.length) return;
    answers.pop();
    drawMeter();
    ask(nextQuestion(data, answers)!);
  });
  $("[data-cr-restart]").addEventListener("click", () => {
    start();
    scrollToY(root.getBoundingClientRect().top + window.scrollY - 100);
  });
  // Number keys pick an answer (1 = first option)
  document.addEventListener("keydown", (e) => {
    if ($("[data-cr-play]").hidden || e.metaKey || e.ctrlKey || e.altKey || (e.target as HTMLElement).closest("input, textarea")) return;
    const b = stage.querySelectorAll<HTMLButtonElement>(".cr-opt")[Number(e.key) - 1];
    if (b) b.click();
  });
  start();
</script>
