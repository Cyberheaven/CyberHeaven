---
import { site } from "../../lib/site";
import ScrollWords from "../ScrollWords.astro";
import ScrollFade from "../ScrollFade.astro";
import Icon from "../Icon.astro";
const { about } = site;
// On the /about page itself the "More about" link is left out.
const { more = true } = Astro.props as { more?: boolean };
---
<section id="about" class="about">
  <div class="about-stage">
    <div class="about-parallax" data-parallax>
      <div class="about-media">
        <img src="/assets/principle-2.webp" alt="" loading="lazy" />
      </div>
    </div>
    <div class="about-scrim" aria-hidden="true"></div>
    <div class="about-content">
      <div class="about-statement-row shell">
        <div class="about-statement">
          <ScrollWords as="h2" class="h2 balance" style="text-align: end" text={about.statement} />
        </div>
      </div>
      <div class="about-bio-row shell">
        <div class="about-bio-col">
          <p class="body muted">ABOUT</p>
          <ScrollFade>
            <div class="about-paragraphs">
              <p class="body balance">{about.bio}</p>
              <p class="body balance">
                {about.contactLead} <a href={`mailto:${site.email}`} style="color: var(--white)">{site.email}</a> {about.contactTail}
              </p>
            </div>
          </ScrollFade>
          {more && <a class="body-sb text-link" href="/about">More about {site.name}<Icon name="arrow-right" size={18} /></a>}
        </div>
      </div>
    </div>
  </div>
</section>
