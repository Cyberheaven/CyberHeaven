---
import { getArticles } from "../../lib/site";
import ScrollWords from "../ScrollWords.astro";
import Icon from "../Icon.astro";

const articles = (await getArticles()).slice(0, 6);
const fmt = new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });
---
<section id="latest" class="latest container">
  <div class="latest-head">
    <ScrollWords as="h2" class="h2 balance" text="Latest articles" />
    <a class="body-sb text-link" href="/articles">All articles<Icon name="arrow-right" size={18} /></a>
  </div>
  <ul class="latest-grid">
    {articles.map((a) => (
      <li>
        <a class="acard" href={`/articles/${a.id}`}>
          <div class="acard-media"><img src={a.data.cover} alt={a.data.coverAlt} loading="lazy" /></div>
          <p class="caption acard-meta">
            <span>{a.data.category.toUpperCase()}</span>
            <time datetime={a.data.date.toISOString().slice(0, 10)}>{fmt.format(a.data.date)}</time>
          </p>
          <h3 class="h4 balance">{a.data.title}</h3>
          <p class="body muted acard-excerpt">{a.data.excerpt}</p>
        </a>
      </li>
    ))}
  </ul>
</section>
