---
import Base from "../layouts/Base.astro";
import Topbar from "../components/Topbar.astro";
import Hero from "../components/sections/Hero.astro";
import About from "../components/sections/About.astro";
import Principles from "../components/sections/Principles.astro";
import Ticker from "../components/sections/Ticker.astro";
import Services from "../components/sections/Services.astro";
import ResourcePicks from "../components/sections/ResourcePicks.astro";
import Tools from "../components/sections/Tools.astro";
import FAQ from "../components/sections/FAQ.astro";
import Contact from "../components/sections/Contact.astro";
import Footer from "../components/sections/Footer.astro";
---
<Base>
  <Topbar path="/" />
  <main>
    <Hero />
    <About />
    <Principles />
    <Ticker />
    <Services />
    <Tools />
    <ResourcePicks />
    <FAQ />
    <Contact />
  </main>
  <Footer />
</Base>
