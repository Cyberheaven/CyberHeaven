---
import { getArticles, site } from "../../lib/site";
import Icon from "../Icon.astro";

const articles = (await getArticles()).slice(0, 5);
const slides = articles.map((a) => ({
  src: a.data.cover,
  alt: a.data.coverAlt,
  category: a.data.category,
  title: a.data.title,
  link: `/articles/${a.id}`,
}));
const n = slides.length;
// Title letters, grouped by word so a word never splits across lines. Each letter keeps its
// position in the whole title, which sets its animation delay.
const words = (title: string) => {
  let i = 0;
  return title.split(" ").map((w) => {
    const letters = w.split("").map((ch) => [ch, i++] as const);
    i++;
    return letters;
  });
};
---
<section id="hero" class="hero container">
  <div class="hero-stage">
    <div style="width: 100%; position: relative; display: flex; flex-direction: column; align-items: center">
      <div class="pc-root" style={`--n: ${n}`} data-carousel data-slides={JSON.stringify(slides.map((s) => s.src))}>
        <div class="pc-sticky">
          <canvas class="pc-canvas"></canvas>
          <div class="pc-overlays">
            {slides.map((s, i) => (
              <div class={"pc-center pc-overlay" + (i === 0 ? " pc-ref-active" : "")} style={`--i: ${i}`} data-overlay>
                <a class="pc-ref-link" href={s.link} aria-label={`Open ${s.title}`}>
                  <span class="pc-ref-ltr pc-cat">{s.category}</span>
                  <h2 class="pc-title">
                    {words(s.title).map((w, wi) => (
                      <>{wi > 0 && " "}<span class="pc-word">{w.map(([ch, li]) => (
                        <span class="pc-ref-ltr" style={`transition-delay: ${(0.12 + li * 0.03).toFixed(2)}s`}>{ch}</span>
                      ))}</span></>
                    ))}
                  </h2>
                  <span class="pc-ref-btn" aria-hidden="true"><Icon name="carousel-arrow" size={22} /></span>
                </a>
              </div>
            ))}
          </div>
          {n > 1 && (
            <div class="pc-bar" data-bar>
              {slides.map((s, i) => (
                <button type="button" class="pc-nav-btn" aria-label={`Go to ${s.title}`} aria-current={i === 0 ? "true" : undefined} data-goto={i}>
                  <span class={"pc-nav-bar" + (i === 0 ? " pc-nav-active" : "")}></span>
                </button>
              ))}
            </div>
          )}
        </div>
        <div class="pc-fallback">
          {slides.map((s) => (
            <section class="pc-fb-slide pc-ref-active">
              <div class="pc-fb-media"><img src={s.src} alt={s.alt} loading="lazy" /></div>
              <div class="pc-center">
                <a class="pc-ref-link" href={s.link} aria-label={`Open ${s.title}`}>
                  <span class="pc-ref-ltr pc-cat">{s.category}</span>
                  <h2 class="pc-title">{words(s.title).map((w, wi) => <>{wi > 0 && " "}<span class="pc-word">{w.map(([ch]) => <span class="pc-ref-ltr">{ch}</span>)}</span></>)}</h2>
                  <span class="pc-ref-btn" aria-hidden="true"><Icon name="carousel-arrow" size={22} /></span>
                </a>
              </div>
            </section>
          ))}
        </div>
      </div>
    </div>
  </div>
  <div class="hero-bottom">
    <h1 class="body balance hero-heading">{site.tagline}</h1>
  </div>
</section>
