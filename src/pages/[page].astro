---
import Base from "../layouts/Base.astro";
import Topbar from "../components/Topbar.astro";
import Footer from "../components/sections/Footer.astro";
import { render } from "astro:content";
import { getPages, site } from "../lib/site";
import "../styles/prose.css";

export async function getStaticPaths() {
  const pages = (await getPages()).filter((p) => !p.id.startsWith("_"));
  return pages.map((page) => ({ params: { page: page.id }, props: { page } }));
}

const { page } = Astro.props;
const { Content } = await render(page);
---
<Base title={`${page.data.title} | ${site.name}`} description={page.data.description}>
  <Topbar path={`/${page.id}`} />
  <main>
    <header class="article-head"><h1>{page.data.title}</h1></header>
    <div class="prose"><Content /></div>
  </main>
  <Footer />
</Base>
