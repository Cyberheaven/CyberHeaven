---
import Base from "../../layouts/Base.astro";
import Topbar from "../../components/Topbar.astro";
import Footer from "../../components/sections/Footer.astro";
import Avatar from "../../components/Avatar.astro";
import Icon from "../../components/Icon.astro";
import { render } from "astro:content";
import { getArticles, getPeople, site } from "../../lib/site";
import categories from "../../data/categories.json";
import "../../styles/prose.css";
import "../../styles/profile.css";

export async function getStaticPaths() {
  return (await getPeople()).map((person) => ({ params: { person: person.id }, props: { person } }));
}

const { person } = Astro.props;
const p = person.data;
const { Content } = await render(person);
const hasBio = Boolean(person.body?.trim());
const written = (await getArticles()).filter((a) => a.data.author.id === person.id);
const roles = [...categories.roles.map((r) => r.name).filter((r) => p.roles.includes(r)), ...p.roles.filter((r) => !categories.roles.some((c) => c.name === r))];
const firstName = p.name.split(" ")[0];
const words = p.name.split(" ");
const fmt = new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });
const since = p.joined && new Intl.DateTimeFormat("en-GB", { month: "long", year: "numeric", timeZone: "UTC" }).format(p.joined);
const external = (url: string) => /^https?:/.test(url);
const description = p.headline ? `${p.name}: ${p.headline}.` : `${p.name}, ${roles.join(", ").toLowerCase() || "member"} at ${site.name}.`;
---
<Base title={`${p.name} | ${site.name}`} description={description}>
  <Topbar path={`/team/${person.id}`} />
  <main>
    <section class="shell pf">
      <div class="pf-side">
        <Avatar name={p.name} src={p.avatar} size={240} class="pf-avatar" />
        {p.links.length > 0 && (
          <ul class="pf-links" aria-label={`${p.name} elsewhere`}>
            {p.links.map((l) => (
              <li>
                <a href={l.url} target={external(l.url) ? "_blank" : undefined} rel={external(l.url) ? "me noreferrer" : undefined}>
                  <span class="body-sb">{l.label}</span>
                  <Icon name="arrow-up-right" size={18} />
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>

      <div class="pf-main">
        <h1 class="h1 balance phead-title">
          {words.map((w, i) => <>{i > 0 && " "}<span class="phead-w" style={`--d: ${i * 60}ms`}>{w}</span></>)}
        </h1>
        {(p.headline || p.pronouns) && (
          <p class="phead-lead" style={`--d: ${words.length * 60 + 120}ms`}>
            {p.headline}{p.headline && p.pronouns && " · "}{p.pronouns && <span>{p.pronouns}</span>}
          </p>
        )}
        <div class="phead-extra pf-facts" style={`--d: ${words.length * 60 + 240}ms`}>
          {roles.length > 0 && <p class="pf-roles">{roles.map((r) => <a class="tag" href={`/team?role=${encodeURIComponent(r)}`}>{r}</a>)}</p>}
          <dl class="pf-meta">
            {p.alumni && <div><dt>Status</dt><dd>Past member, with thanks</dd></div>}
            {p.location && <div><dt>Based in</dt><dd>{p.location}</dd></div>}
            {since && <div><dt>With {site.name} since</dt><dd>{since}</dd></div>}
            {written.length > 0 && <div><dt>Articles</dt><dd>{written.length}</dd></div>}
          </dl>
        </div>
        {hasBio && <div class="prose pf-bio"><Content /></div>}
      </div>
    </section>

    {written.length > 0 && (
      <section class="shell pf-articles">
        <h2 class="h3">Articles by {firstName}</h2>
        <ul class="latest-grid">
          {written.map((a) => (
            <li class="sf">
              <a class="acard" href={`/articles/${a.id}`}>
                <div class="acard-media"><img src={a.data.cover} alt={a.data.coverAlt} loading="lazy" /></div>
                <p class="caption acard-meta">
                  <span>{a.data.category.toUpperCase()}</span>
                  <time datetime={a.data.date.toISOString().slice(0, 10)}>{fmt.format(a.data.date)}</time>
                </p>
                <h3 class="h4 balance">{a.data.title}</h3>
                <p class="body muted acard-excerpt">{a.data.excerpt}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="shell pf-back">
      <a class="text-link body-sb" href="/team"><Icon name="arrow-right" size={18} />Everyone on the team</a>
    </section>
  </main>
  <Footer />
</Base>

