---
import { site } from "../../lib/site";
import ScrollWords from "../ScrollWords.astro";
import Icon from "../Icon.astro";
const { contact } = site;
---
<section id="contact" class="contact container">
  <div class="contact-main">
    <div class="contact-left">
      <ScrollWords as="h2" class="h2 balance" text={contact.heading} />
      <a class="contact-card" href={`mailto:${site.email}`}>
        <span class="contact-avatar"><img src="/assets/logo.webp" alt="" loading="lazy" /></span>
        <span class="body">{site.email}</span>
      </a>
    </div>
    <div class="contact-right">
      <div class="contact-block">
        <p class="body-sb" style="color: var(--grey)">{contact.label}</p>
        <p class="body balance">{contact.text}</p>
        <a class="btn" href={site.discord} target="_blank" rel="noreferrer"><span class="body-sb">Join the Discord</span><Icon name="arrow-up-right" size={20} /></a>
      </div>
      <div class="divider" aria-hidden="true"></div>
      <div class="contact-block">
        <p class="body-sb" style="color: var(--grey)">{contact.contributeLabel}</p>
        <p class="body balance">{contact.contributeText}</p>
        <a class="btn btn-ghost" href={`mailto:${site.email}?subject=${encodeURIComponent("Contributing to CyberHeaven")}`}><span class="body-sb">Volunteer or write for us</span><Icon name="arrow-up-right" size={20} /></a>
      </div>
    </div>
  </div>
</section>
