---
import Base from "../layouts/Base.astro";
import Topbar from "../components/Topbar.astro";
import Footer from "../components/sections/Footer.astro";
import ScrollRing from "../components/ScrollRing.astro";
import Icon from "../components/Icon.astro";
import { site } from "../lib/site";
import home from "../content/pages/home.json";
import page from "../content/pages/notfound.json";
---
<Base title={`${page.title} | ${site.name}`}>
  <Topbar path="/404" />
  <main>
    <section class="nf-hero">
      <ScrollRing images={home.topics.map((t) => t.image)} radius={360} scrollSpeed={0.02} autoSpin={2} />
      <div class="nf-content">
        <h1 class="h1">{page.title}</h1>
        <p class="body muted balance nf-text">{page.text}</p>
        <div class="nf-actions">
          <a class="btn" href="/"><span class="body-sb">{page.homeButton}</span><Icon name="arrow-up-right" size={20} /></a>
          <a class="btn btn-ghost" href="/articles"><span class="body-sb">{page.articlesButton}</span><Icon name="arrow-up-right" size={20} /></a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
